{
  "name": "@architectureworld/dsh-preplanning-agent",
  "version": "2.0.0",
  "description": "DSH 前期策划智能体插件",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "SCHEMASET.sha256",
    "schemas/0.1.0/*.schema.json",
    "cordis.patch.yml",
    "contracts/v0.6/**",
    "contracts/v0.7/**",
    "!contracts/v0.6/**/__pycache__/**",
    "!contracts/v0.6/**/*.pyc",
    "compatibility/dsh-baseline.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare:presentation-contract": "node scripts/prepare-presentation-contract.mjs",
    "prepare:presentation-runtime-assets": "node scripts/prepare-presentation-contract-runtime-assets.mjs",
    "prebuild": "pnpm prepare:presentation-runtime-assets",
    "build": "tsdown --config-loader native && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "golden:build": "tsx scripts/build-golden-project-cli.ts",
    "golden:build-v080": "tsx scripts/build-golden-project-cli.ts --profile client-v080",
    "golden:inspect-v080": "tsx scripts/inspect-client-artifacts.ts",
    "verify:presentation-contract": "node scripts/verify-presentation-contract-lock.mjs",
    "verify:alignment-versions": "node scripts/verify-alignment-version-consistency.mjs",
    "test:presentation-standard": "pnpm verify:presentation-contract && vitest run tests/presentation-standard-*.spec.ts tests/presentation-workspace-runtime.spec.ts tests/workspace-project-root.spec.ts tests/direct-start-workspace.client.spec.ts tests/workspace-form-draft.client.spec.tsx tests/workspace-open-folder-ui.client.spec.tsx tests/workspace-panel-polish.client.spec.tsx tests/presentation-auto-sync.spec.ts tests/presentation-migration-guidance.spec.ts tests/parallel-workflow-executor.spec.ts tests/automation-workflow-committer.spec.ts tests/coordinator-parallel.spec.ts tests/presentation-sync-status.client.spec.tsx tests/automatic-gate-after-serial.spec.ts --maxWorkers=1 && node scripts/verify-presentation-standard-integration.mjs",
    "test": "pnpm verify:alignment-versions && pnpm verify:presentation-contract && pnpm build && vitest run --maxWorkers=1",
    "test:built": "vitest run tests/built-package.spec.ts tests/built-presentation-runtime.spec.ts --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json",
    "test:continuous-sync": "vitest run tests/presentation-auto-sync.spec.ts tests/presentation-migration-guidance.spec.ts tests/parallel-workflow-executor.spec.ts tests/automation-workflow-committer.spec.ts tests/coordinator-parallel.spec.ts tests/presentation-sync-status.client.spec.tsx tests/automatic-gate-after-serial.spec.ts --maxWorkers=1"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "pptxgenjs": "4.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@architectureworld/presentation-contracts": "file:vendor/presentation-contracts/architectureworld-presentation-contracts-0.1.0.tgz",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zod": "4.4.3"
  }
}
