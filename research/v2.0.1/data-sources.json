      "accessModes": ["web_page", "web_search"],
      "supportedDataKinds": ["population", "census", "economy", "industry", "investment", "price_index", "annual_statistics"],
      "freshnessPolicy": { "maxAgeDays": 400, "refreshOnProjectStart": true, "notes": "按指标发布周期取最新已发布统计期，并记录统计期 asOf。" },
      "reliabilityGrade": "A",
      "notes": "人口、经济、普查、年度/月度统计的国家级权威入口；地方项目仍优先补充所在地统计局同口径数据。"
    },
