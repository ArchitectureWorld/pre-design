      "accessModes": ["workspace_file", "manual_import", "professional_tool"],
      "supportedDataKinds": ["project_document", "survey", "drawing", "cad", "bim", "gis", "spreadsheet", "cost", "schedule", "boundary", "measurement"],
      "freshnessPolicy": { "maxAgeDays": null, "refreshOnProjectStart": true, "notes": "按文件版本、签发日期和项目 Revision 复核；新版本出现时旧证据标记 stale。" },
      "reliabilityGrade": "A",
      "notes": "项目内正式任务书、批复、总平/红线、测量成果、正式表格和专业计算输出优先于外部二手信息。"
    },
    {
      "sourceId": "dsh-user-statement",
      "name": "DSH 用户直接陈述",
      "publisher": "当前项目用户",
      "priority": "P4",
      "authorityLevel": "auxiliary",
      "homepage": null,
      "allowedDomains": [],
      "accessModes": ["manual_import"],
      "supportedDataKinds": ["project_intent", "project_identity", "stakeholder_statement", "decision_input"],
      "freshnessPolicy": { "maxAgeDays": null, "refreshOnProjectStart": false, "notes": "保留消息时间和 Session 定位；除非用户明确确认，不升级为项目正式事实。" },
      "reliabilityGrade": "C",
      "notes": "必须保持 claimClass=user_statement；可触发研究，但不能替代法定/测量/官方证据。"
    },
    {
