{
  "contract_version": "0.6.0",
  "tool_name": "preplanning_apply_commands",
  "exposure": "MODEL_FACING",
  "purpose": "模型提交结构化 ProposalEnvelope；插件执行 Schema、规则、权限、证据、版本和 Workflow Guard 校验后，决定退回、进入人工复核或提交 provisional revision。",
  "permissions": {
    "allowed_actor_types": [
      "agent"
    ],
    "direct_state_write": false,
    "approve_gate": false,
    "waive_hard_constraint": false
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "project_id",
      "expected_revision",
      "actor",
      "reason",
      "idempotency_key",
      "workflow_id",
      "commands"
    ],
    "properties": {
      "project_id": {
        "type": "string",
        "minLength": 1
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0
      },
      "actor": {
        "type": "object",
        "required": [
          "actor_id",
          "actor_type",
          "role"
        ],
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "actor_type": {
            "type": "string",
            "enum": [
              "human",
              "agent",
              "system_service"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 8
      },
      "workflow_id": {
        "type": "string",
        "pattern": "^preplan\\.wf\\.[0-9]{2}\\.[0-9]{2}$"
      },
      "commands": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "command_id",
            "operation",
            "target_object_id",
            "patch"
          ],
          "properties": {
            "command_id": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "enum": [
                "create",
                "replace",
                "merge_patch",
                "supersede"
              ]
            },
            "target_object_id": {
              "type": "string",
              "pattern": "^(PS|BL|DG|OB|OP|PG|SP|IM)[0-9]{2}$"
            },
            "patch": {
              "type": "object",
              "additionalProperties": true
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "question_candidate": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      },
      "correlation_id": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "proposal_id",
      "status",
      "current_revision",
      "validation_report",
      "events"
    ],
    "properties": {
      "proposal_id": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "rejected",
          "validation_failed",
          "pending_review",
          "committed_provisional",
          "idempotent_replay"
        ]
      },
      "current_revision": {
        "type": "integer",
        "minimum": 0
      },
      "new_revision": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      },
      "validation_report": {
        "type": "object",
        "additionalProperties": true
      },
      "review_task_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "opened_question_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "events": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": false
  },
  "examples": {
    "input": {
      "project_id": "project-001",
      "expected_revision": 3,
      "actor": {
        "actor_id": "agent-1",
        "actor_type": "agent",
        "role": "planning_agent",
        "display_name": "DSH Agent"
      },
      "reason": "形成项目身份 provisional 提案",
      "idempotency_key": "idem-00000001",
      "workflow_id": "preplan.wf.01.01",
      "commands": [
        {
          "command_id": "cmd-1",
          "operation": "merge_patch",
          "target_object_id": "PS01",
          "patch": {
            "data": {
              "canonical_name": "项目暂名"
            }
          }
        }
      ],
      "question_candidate": null,
      "correlation_id": "corr-1"
    },
    "output": {
      "proposal_id": "proposal-1",
      "status": "pending_review",
      "current_revision": 3,
      "new_revision": null,
      "validation_report": {
        "passed": true
      },
      "review_task_id": "review-1",
      "opened_question_id": null,
      "events": []
    }
  }
}