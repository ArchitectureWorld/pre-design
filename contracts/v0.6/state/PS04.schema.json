{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:preplan:v0.6:state:PS04",
  "title": "StakeholderGraph",
  "description": "参与主体清单、决策关系、确认关系、重点沟通对象。",
  "type": "object",
  "required": [
    "object_id",
    "object_type",
    "schema_version",
    "project_id",
    "chapter_id",
    "work_item_id",
    "status",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "source_snapshot",
    "data",
    "approval"
  ],
  "properties": {
    "object_id": {
      "const": "PS04"
    },
    "object_type": {
      "const": "StakeholderGraph"
    },
    "schema_version": {
      "const": "0.6.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "chapter_id": {
      "const": "01"
    },
    "work_item_id": {
      "const": "01-04"
    },
    "status": {
      "$ref": "#/$defs/StateStatus"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "data": {
      "type": "object",
      "required": [
        "actors",
        "roles",
        "interests",
        "influence",
        "decision_edges",
        "confirmation_owner",
        "affected_groups",
        "engagement_priority",
        "evidence_refs"
      ],
      "properties": {
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorRef"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "minItems": 0
        },
        "interests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "minItems": 0
        },
        "influence": {
          "$ref": "#/$defs/Rating"
        },
        "decision_edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "confirmation_owner": {
          "$ref": "#/$defs/ActorRef"
        },
        "affected_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorRef"
          }
        },
        "engagement_priority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "minItems": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "$ref": "#/$defs/QualityProfile"
    },
    "approval": {
      "$ref": "#/$defs/ApprovalRecord"
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\s].*[^\\s]$|^[^\\s]$"
    },
    "StateStatus": {
      "type": "string",
      "enum": [
        "draft",
        "provisional",
        "pending_review",
        "confirmed",
        "rejected",
        "stale",
        "superseded"
      ]
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "approved_with_conditions",
        "returned",
        "rejected",
        "stale"
      ]
    },
    "Confidence": {
      "type": "object",
      "required": [
        "level",
        "score",
        "basis"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "very_low",
            "low",
            "medium",
            "high",
            "very_high"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Metric": {
      "type": "object",
      "required": [
        "name",
        "value",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "integer",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "additionalProperties": true
    },
    "NumericRange": {
      "type": "object",
      "required": [
        "min",
        "max",
        "unit"
      ],
      "properties": {
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "additionalProperties": false
    },
    "ActorRef": {
      "type": "object",
      "required": [
        "actor_id",
        "name",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contact_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "EvidenceLocator": {
      "type": "object",
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "slide": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sheet": {
          "type": [
            "string",
            "null"
          ]
        },
        "cell_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "geometry_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "required": [
        "evidence_id",
        "asset_id",
        "version_id",
        "claim_class",
        "locator"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_class": {
          "type": "string",
          "enum": [
            "fact",
            "source_conclusion",
            "user_statement",
            "agent_inference",
            "assumption",
            "decision",
            "missing"
          ]
        },
        "locator": {
          "$ref": "#/$defs/EvidenceLocator"
        },
        "quote_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "reliability": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "GeometryRef": {
      "type": "object",
      "required": [
        "geometry_id",
        "geometry_type",
        "crs"
      ],
      "properties": {
        "geometry_id": {
          "type": "string",
          "minLength": 1
        },
        "geometry_type": {
          "type": "string",
          "enum": [
            "Point",
            "LineString",
            "Polygon",
            "MultiPoint",
            "MultiLineString",
            "MultiPolygon",
            "BIMElementSet",
            "CADLayerSet",
            "Unknown"
          ]
        },
        "crs": {
          "type": "string",
          "minLength": 1
        },
        "source_asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "area_m2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "provisional",
            "verified",
            "disputed"
          ]
        }
      },
      "additionalProperties": true
    },
    "Scope": {
      "type": "object",
      "required": [
        "scope_id",
        "label",
        "scope_type",
        "basis",
        "status"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "scope_type": {
          "type": "string",
          "enum": [
            "study",
            "impact",
            "implementation",
            "content",
            "phase",
            "exclusion",
            "spatial",
            "authority",
            "other"
          ]
        },
        "description": {
          "type": "string"
        },
        "geometry_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeometryRef"
          }
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "provisional",
            "verified",
            "disputed"
          ]
        }
      },
      "additionalProperties": true
    },
    "Entity": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        }
      },
      "additionalProperties": true
    },
    "Event": {
      "type": "object",
      "required": [
        "event_id",
        "name",
        "date",
        "event_type"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "event_type": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        }
      },
      "additionalProperties": true
    },
    "TimeConstraint": {
      "type": "object",
      "required": [
        "name",
        "deadline",
        "hardness"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "hardness": {
          "type": "string",
          "enum": [
            "hard",
            "soft",
            "unknown"
          ]
        },
        "source": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Rating": {
      "type": "object",
      "required": [
        "level",
        "rationale"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "very_low",
            "low",
            "medium",
            "high",
            "very_high",
            "unknown"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "rationale": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        }
      },
      "additionalProperties": true
    },
    "Formula": {
      "type": "object",
      "required": [
        "formula_id",
        "expression",
        "output_unit",
        "parameters"
      ],
      "properties": {
        "formula_id": {
          "type": "string"
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "output_unit": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rounding": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ParameterSource": {
      "type": "object",
      "required": [
        "parameter",
        "value",
        "unit",
        "source_type"
      ],
      "properties": {
        "parameter": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "project_measurement",
            "official_standard",
            "official_statistics",
            "benchmark",
            "expert_judgment",
            "assumption"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "sensitivity_range": {
          "$ref": "#/$defs/NumericRange"
        }
      },
      "additionalProperties": true
    },
    "Edge": {
      "type": "object",
      "required": [
        "edge_id",
        "from",
        "to",
        "relation"
      ],
      "properties": {
        "edge_id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "strength": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "evidence_strength": {
          "type": "string",
          "enum": [
            "none",
            "weak",
            "medium",
            "strong",
            "confirmed"
          ]
        }
      },
      "additionalProperties": true
    },
    "ApprovalRecord": {
      "type": "object",
      "required": [
        "status",
        "required_role"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "required_role": {
          "type": "string"
        },
        "approver": {
          "oneOf": [
            {
              "$ref": "#/$defs/ActorRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entity"
          }
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "QualityProfile": {
      "type": "object",
      "required": [
        "completeness",
        "consistency",
        "timeliness",
        "traceability",
        "reproducibility"
      ],
      "properties": {
        "completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "consistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timeliness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "traceability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reproducibility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grade": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "RaciRow": {
      "type": "object",
      "required": [
        "task",
        "responsible",
        "accountable"
      ],
      "properties": {
        "task": {
          "type": "string"
        },
        "responsible": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorRef"
          }
        },
        "accountable": {
          "$ref": "#/$defs/ActorRef"
        },
        "consulted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorRef"
          }
        },
        "informed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorRef"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-preplan": {
    "chapter": "01",
    "work_item_id": "01-04",
    "workflow": "preplan.wf.01.04",
    "gate": "G1",
    "reads": [
      "PS02",
      "PS03"
    ],
    "automation": "A1",
    "risk": "H",
    "semantic_rules": [],
    "forbidden_direct_writers": [
      "agent",
      "llm",
      "rendered_artifact"
    ],
    "write_path": [
      "ProposalEnvelope",
      "SchemaValidator",
      "RuleValidator",
      "PermissionValidator",
      "ProjectStateRepository"
    ]
  }
}