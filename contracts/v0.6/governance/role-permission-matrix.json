  "assignment_rules": [
    "approve_gate、approve_gate_with_conditions、return_gate 还要求 actor 被指派为对应 Gate 的 approver。",
    "confirm_work_item 还要求 actor 被指派为对应工作项 reviewer，且高风险专业签核完整。",
    "waive_hard_constraint 仅在 constraint_authority 的 authority_scope 内有效，必须保留原约束与豁免依据。",
    "project_owner 负责角色配置，但不能将 agent 或 system_service 指派为人工审批主体。"
  ],
  "absolute_denials": {
    "agent": [
      "commit_provisional",
      "confirm_work_item",
      "approve_gate",
      "approve_gate_with_conditions",
      "return_gate",
      "approve_revision",
      "apply_revision",
      "waive_hard_constraint"
    ],
    "system_service": [
      "confirm_work_item",
      "approve_gate",
      "approve_gate_with_conditions",
      "return_gate",
      "approve_revision",
      "waive_hard_constraint"
    ],
    "rendered_artifact": [
      "all_state_mutations",
      "all_approvals"
    ]
  }
