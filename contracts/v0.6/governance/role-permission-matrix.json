{
  "version": "0.6.0",
  "roles": {
    "agent": {
      "kind": "non_human",
      "description": "理解资料、调用允许工具、形成候选与 ProposalEnvelope；无审批权。"
    },
    "system_service": {
      "kind": "non_human",
      "description": "执行校验、确定性计算、provisional 写入、影响传播与审计；无业务批准权。"
    },
    "workflow_operator": {
      "kind": "human_or_service",
      "description": "启动、暂停、恢复和分派工作流；不能替代专业或决策批准。"
    },
    "data_steward": {
      "kind": "human",
      "description": "确认来源、版本、口径、质量和证据绑定。"
    },
    "discipline_reviewer": {
      "kind": "human",
      "description": "对规划、建筑、GIS、交通、市政、造价、财务等高风险专业结论签核。"
    },
    "chapter_reviewer": {
      "kind": "human",
      "description": "确认单个章节工作项成果可进入章节 Gate。"
    },
    "decision_owner": {
      "kind": "human",
      "description": "确认核心决策、方案选择和章节 Gate；仅对被指派项目有效。"
    },
    "project_owner": {
      "kind": "human",
      "description": "配置项目、角色、责任人和流程范围；不自动获得专业豁免权。"
    },
    "constraint_authority": {
      "kind": "human",
      "description": "仅在法定或组织授权范围内批准硬约束例外。"
    },
    "auditor": {
      "kind": "human",
      "description": "只读审计、导出历史、校验快照，不修改状态。"
    },
    "external_participant": {
      "kind": "human",
      "description": "提交资料、意见和确认反馈，不读取未授权状态，不批准 Gate。"
    }
  },
  "commands": [
    "read_state",
    "submit_evidence",
    "run_tool",
    "create_proposal",
    "submit_proposal",
    "validate_proposal",
    "commit_provisional",
