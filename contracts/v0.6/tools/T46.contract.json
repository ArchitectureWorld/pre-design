        "pattern": "^[^\\s].*[^\\s]$|^[^\\s]$"
      },
      "StateStatus": {
        "type": "string",
        "enum": [
          "draft",
          "provisional",
          "pending_review",
          "confirmed",
          "rejected",
          "stale",
          "superseded"
        ]
      },
      "ApprovalStatus": {
        "type": "string",
        "enum": [
          "not_required",
          "pending",
          "approved",
          "approved_with_conditions",
          "returned",
          "rejected",
          "stale"
