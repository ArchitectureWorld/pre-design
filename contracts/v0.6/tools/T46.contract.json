{
  "contract_version": "0.6.0",
  "tool_id": "T46",
  "name": "人工任务与审批路由",
  "kind": "workflow",
  "owner": "DSH 工作流",
  "purpose": "把补资料、专业复核、部门会商、用户确认和 Gate 审批分派到责任主体。",
  "execution": {
    "mode": "sync",
    "determinism": "deterministic",
    "idempotent": false,
    "timeout_seconds": 30,
    "retry": {
      "max_attempts": 0,
      "backoff": "exponential",
      "retry_only": [
        "TOOL_TIMEOUT",
        "EXTERNAL_SERVICE_UNAVAILABLE",
        "VERSION_CONFLICT"
      ]
    }
  },
  "risk": "M",
  "permissions": {
    "invoke_roles": [
      "agent",
      "workflow_operator",
      "system_service"
    ],
    "review_roles": [
      "data_steward",
      "chapter_reviewer"
    ],
    "forbidden": [
      "approve_gate",
      "waive_hard_constraint",
      "direct_project_state_write"
    ]
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
