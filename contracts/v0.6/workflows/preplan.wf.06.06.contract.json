{
  "contract_version": "0.6.0",
  "workflow_id": "preplan.wf.06.06",
  "skill_id": "preplan.skill.program-capacity",
  "chapter_id": "06",
  "work_item_id": "06-06",
  "title": "公益经营边界与收费原则",
  "purpose": "明确哪些服务必须保障公益，哪些可以经营，怎样避免相互挤占。",
  "reads": [
    "PG02",
    "PG03",
    "PG04",
    "BL01"
  ],
  "writes": "PG06",
  "output_schema_ref": "../state/PG06.schema.json",
  "atomic_tools": [
    "T23",
    "T24",
    "T36",
    "T37",
    "T42",
    "T46"
  ],
  "automation_level": "A2",
  "risk": "H",
  "gate_id": "G6",
  "initial_state": "NOT_STARTED",
  "states": {
    "NOT_STARTED": "尚未初始化。",
    "READY": "上游满足或缺口已显式，允许启动。",
    "RUNNING": "正在执行资料、工具或人工任务。",
    "BLOCKED": "存在阻断缺口，等待补证或授权。",
    "PROPOSAL_READY": "已形成 ProposalEnvelope，尚未通过校验。",
    "VALIDATION_FAILED": "Schema、规则、权限、版本或依赖校验失败。",
    "PENDING_REVIEW": "等待指定人工复核。",
    "COMMITTED_PROVISIONAL": "已写入 provisional Project State，仍需人工确认或 Gate 处理。",
    "CONFIRMED": "工作项成果已由授权人员确认。",
    "REJECTED": "人工复核退回。",
    "STALE": "上游语义变更导致当前成果失效。",
    "CANCELLED": "工作项被授权取消。"
  },
  "transitions": [
    {
      "command": "prepare",
      "from": [
        "NOT_STARTED",
        "STALE",
        "REJECTED"
      ],
      "to": "READY",
      "roles": [
        "workflow_operator",
        "system_service"
      ],
      "guards": [
        "workflow_enabled",
        "upstream_versions_resolved_or_missing_declared"
      ],
      "state_effect": "none"
    },
    {
      "command": "start",
      "from": [
        "READY"
      ],
      "to": "RUNNING",
      "roles": [
        "agent",
        "workflow_operator",
        "system_service"
      ],
      "guards": [
        "required_inputs_available_or_fallback_active"
      ],
      "state_effect": "none"
    },
    {
      "command": "block",
      "from": [
        "READY",
        "RUNNING",
        "PROPOSAL_READY"
      ],
      "to": "BLOCKED",
      "roles": [
        "agent",
        "workflow_operator",
        "system_service",
        "chapter_reviewer"
      ],
      "guards": [
        "blocking_reason_recorded",
        "owner_and_due_date_set"
      ],
      "state_effect": "human_task"
    },
    {
      "command": "resolve_blocker",
      "from": [
        "BLOCKED"
      ],
      "to": "READY",
      "roles": [
        "workflow_operator",
        "chapter_reviewer",
        "data_steward"
      ],
      "guards": [
        "blocking_evidence_resolved_or_authorized_fallback"
      ],
      "state_effect": "none"
    },
    {
      "command": "submit_proposal",
      "from": [
        "RUNNING"
      ],
      "to": "PROPOSAL_READY",
      "roles": [
        "agent",
        "workflow_operator",
        "system_service"
      ],
      "guards": [
        "proposal_envelope_schema_valid",
        "target_object_matches_workflow",
        "evidence_and_assumptions_declared"
      ],
      "state_effect": "proposal_only"
    },
    {
      "command": "validation_fail",
      "from": [
        "PROPOSAL_READY"
      ],
      "to": "VALIDATION_FAILED",
      "roles": [
        "system_service"
      ],
      "guards": [
        "validator_report_contains_errors"
      ],
      "state_effect": "validation_report"
    },
    {
      "command": "validation_pass_to_review",
      "from": [
        "PROPOSAL_READY"
      ],
      "to": "PENDING_REVIEW",
      "roles": [
        "system_service"
      ],
      "guards": [
        "schema_rules_permissions_versions_pass",
        "human_review_required_or_high_risk",
        "no_undeclared_high_risk_inference"
      ],
      "state_effect": "review_queue"
    },
    {
      "command": "validation_pass_and_commit_provisional",
      "from": [
        "PROPOSAL_READY"
      ],
      "to": "COMMITTED_PROVISIONAL",
      "roles": [
        "system_service"
      ],
      "guards": [
        "schema_rules_permissions_versions_pass",
        "automation_allows_provisional_commit",
        "human_review_not_mandatory",
        "no_high_risk_blocker"
      ],
      "state_effect": "commit_provisional"
    },
    {
      "command": "revise",
      "from": [
        "VALIDATION_FAILED",
        "REJECTED"
      ],
      "to": "RUNNING",
      "roles": [
        "agent",
        "workflow_operator"
      ],
      "guards": [
        "review_or_validation_feedback_acknowledged"
      ],
      "state_effect": "none"
    },
    {
      "command": "request_review",
      "from": [
        "COMMITTED_PROVISIONAL"
      ],
      "to": "PENDING_REVIEW",
      "roles": [
        "workflow_operator",
        "system_service"
      ],
      "guards": [
        "reviewer_assigned"
      ],
      "state_effect": "human_task"
    },
    {
      "command": "approve",
      "from": [
        "PENDING_REVIEW",
        "COMMITTED_PROVISIONAL"
      ],
      "to": "CONFIRMED",
      "roles": [
        "chapter_reviewer",
        "discipline_reviewer",
        "decision_owner"
      ],
      "guards": [
        "actor_assigned_to_work_item",
        "all_high_risk_checks_signed",
        "expected_revision_matches"
      ],
      "state_effect": "commit_confirmed"
    },
    {
      "command": "reject",
      "from": [
        "PENDING_REVIEW"
      ],
      "to": "REJECTED",
      "roles": [
        "chapter_reviewer",
        "discipline_reviewer",
        "decision_owner"
      ],
      "guards": [
        "reason_and_required_revision_paths_recorded"
      ],
      "state_effect": "review_record"
    },
    {
      "command": "dependency_changed",
      "from": [
        "PENDING_REVIEW",
        "COMMITTED_PROVISIONAL",
        "CONFIRMED"
      ],
      "to": "STALE",
      "roles": [
        "system_service"
      ],
      "guards": [
        "semantic_change_impacts_object"
      ],
      "state_effect": "mark_stale"
    },
    {
      "command": "cancel",
      "from": [
        "READY",
        "RUNNING",
        "BLOCKED"
      ],
      "to": "CANCELLED",
      "roles": [
        "project_owner",
        "decision_owner"
      ],
      "guards": [
        "cancellation_reason_recorded"
      ],
      "state_effect": "audit_event"
    }
  ],
  "input_contract": {
    "required_upstream": [
      "PG02",
      "PG03",
      "PG04",
      "BL01"
    ],
    "missing_data_policy": "法律/财政未确认项保持 pending，作为 G8 前置。",
    "evidence_policy": [
      "所有事实与材料原结论必须绑定 EvidenceRef。",
      "Agent 推断和假设必须显式分类。",
      "冲突证据不得静默覆盖。"
    ]
  },
  "proposal_contract": {
    "schema_ref": "../common/proposal-envelope.schema.json",
    "target_object_id": "PG06",
    "allowed_operations": [
      "create",
      "replace",
      "merge_patch",
      "supersede"
    ],
    "direct_state_write": false
  },
  "completion_criteria": [
    "经营功能不得挤占公益容量；建设内容和资金用途保持一致；公益与经营分账。",
    "财政、主管部门、业主和运营主体确认。"
  ],
  "reopen_triggers": [
    "资金政策、资产规则、收费政策或服务底线变化"
  ],
  "failure_recovery": {
    "fallback": "法律/财政未确认项保持 pending，作为 G8 前置。",
    "minimum_reopen": "06-06",
    "preserve_history": true
  },
  "forbidden_actions": [
    "agent_approve_gate",
    "direct_project_state_write",
    "silent_source_overwrite",
    "fabricate_missing_values"
  ],
  "review_policy": {
    "human_review_mandatory": true,
    "provisional_auto_commit_allowed": false,
    "confirmation_roles": [
      "chapter_reviewer",
      "discipline_reviewer",
      "decision_owner"
    ],
    "gate_still_human": true
  },
  "state_reachability_contract": {
    "all_declared_states_must_be_reachable": true,
    "terminal_states": [
      "CONFIRMED",
      "CANCELLED"
    ],
    "conditional_states": {
      "COMMITTED_PROVISIONAL": "Only A3 non-high-risk workflows may enter automatically; other workflows reach it only if future policy explicitly enables the same guard."
    }
  }
}