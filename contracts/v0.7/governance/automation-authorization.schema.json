{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:preplan:runtime:v0.7:automation-authorization",
  "title": "AutomationAuthorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorizationId", "projectId", "grantedBy", "startingRevision", "scope", "status", "grantedAt"],
  "properties": {
    "authorizationId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "grantedBy": { "$ref": "#/$defs/actor" },
    "startingRevision": { "type": "integer", "minimum": 0 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapterIds", "workflowIds", "gateIds", "maxVisualGenerations", "maxModelTurns", "stopOnBlocking"],
      "properties": {
        "chapterIds": { "type": "array", "items": { "type": "string", "pattern": "^0[1-8]$" }, "uniqueItems": true },
        "workflowIds": { "type": "array", "items": { "type": "string", "pattern": "^preplan\\.wf\\.0[1-8]\\.[0-9]{2}$" }, "uniqueItems": true },
        "gateIds": { "type": "array", "items": { "type": "string", "pattern": "^G[1-8]$" }, "uniqueItems": true },
        "maxVisualGenerations": { "type": "integer", "minimum": 0 },
        "maxModelTurns": { "type": "integer", "minimum": 1 },
        "stopOnBlocking": { "type": "boolean" }
      }
    },
    "status": { "enum": ["active", "revoked", "expired"] },
    "grantedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "revokedAt": { "type": "string", "format": "date-time" },
    "revokedBy": { "$ref": "#/$defs/actor" },
    "revocationReason": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "name", "role"],
      "properties": {
        "actorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    }
  }
}
