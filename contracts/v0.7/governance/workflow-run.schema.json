{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:preplan:runtime:v0.7:workflow-run",
  "title": "WorkflowRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "projectId", "workflowId", "chapterId", "workItemId", "targetObjectId", "status", "attempt", "updatedAt"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "workflowId": { "type": "string", "pattern": "^preplan\\.wf\\.0[1-8]\\.[0-9]{2}$" },
    "chapterId": { "type": "string", "pattern": "^0[1-8]$" },
    "workItemId": { "type": "string", "pattern": "^0[1-8]-[0-9]{2}$" },
    "targetObjectId": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{2}$" },
    "status": { "enum": ["not_started", "ready", "running", "blocked", "pending_review", "confirmed", "not_applicable", "superseded"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "proposalId": { "type": "string", "minLength": 1 },
    "confirmedRevision": { "type": "integer", "minimum": 0 },
    "blockedReason": { "type": "string", "minLength": 1 },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "targetObjectId", "disposition", "score", "completionCoverage", "evidenceCoverage", "confidence", "attempt", "maxAttempts", "reasons", "blockers", "assumptions"],
      "properties": {
        "workflowId": { "type": "string", "pattern": "^preplan\\.wf\\.0[1-8]\\.[0-9]{2}$" },
        "targetObjectId": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{2}$" },
        "disposition": { "enum": ["auto_pass", "auto_revise", "needs_human", "blocked_external"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "completionCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "kind", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["external", "quality", "conflict"] },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        },
        "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
